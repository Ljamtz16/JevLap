[Unit]
Description=Jev Lab read-only snapshot consumer
After=network-online.target
[Service]
User=ljamtz
WorkingDirectory=/home/ljamtz/jev-lab
EnvironmentFile=/home/ljamtz/.config/jev-lab/credentials.env
ExecStart=/usr/bin/python3 /home/ljamtz/jev-lab/watch_snapshots.py --source /home/ljamtz/options-system/data/raw/intraday
Restart=on-failure
NoNewPrivileges=true
ReadOnlyPaths=/home/ljamtz/options-system/data/raw/intraday
[Install]
WantedBy=multi-user.target
